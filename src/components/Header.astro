---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import OwnerControls from './OwnerControls.astro';
---
<div class="blog-header">
  <SiteTitle />
  <div class="header-tools"><Search /><OwnerControls /></div>
</div>
<style>
  .blog-header { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 100%; }
  .header-tools { display: flex; align-items: center; gap: 1.5rem; }
  @media (max-width: 49.99rem) { .blog-header, .header-tools { gap: 1rem; } }
</style>
