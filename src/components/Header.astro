---
import StarlightHeader from '@astrojs/starlight/components/Header.astro';
import OwnerControls from './OwnerControls.astro';
---
<div class="blog-header">
  <div class="default-header"><StarlightHeader /></div>
  <OwnerControls />
</div>
<style>
  .blog-header { display: flex; align-items: center; gap: 1rem; height: 100%; }
  .default-header { flex: 1; min-width: 0; }
  @media (max-width: 49.99rem) { .blog-header { gap: .5rem; } }
</style>
