---
interface Props {
  /** home: full-height hero; page: compact header; article: post header. */
  variant?: 'home' | 'page' | 'article';
}
const { variant = 'page' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<section class:list={['banner', `banner-${variant}`, { 'banner-has-aside': hasAside }]}>
  <div class="banner-inner"><slot /></div>
  {hasAside && <div class="banner-aside"><slot name="aside" /></div>}
</section>
