---
import { isHomePage, tagPath } from '../utils/paths';
const { entry } = Astro.locals.starlightRoute;
const isHome = isHomePage(entry.id);
---
<h1 id="_top">{entry.data.title}</h1>
{!isHome && entry.data.tags.length > 0 && <ul class="post-tags" aria-label="태그">
  {entry.data.tags.map((tag) => <li><a href={tagPath(tag)}>{tag}</a></li>)}
</ul>}
