---
import { isHomePage, tagPath } from '../utils/paths';
const { entry } = Astro.locals.starlightRoute;
const isHome = isHomePage(entry.id);
const publishedDate = !isHome && entry.data.publishedAt
  ? new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Seoul' }).format(entry.data.publishedAt)
  : undefined;
---
<h1 id="_top">{entry.data.title}</h1>
{publishedDate && <p class="article-date">{publishedDate}</p>}
{!isHome && entry.data.tags.length > 0 && <ul class="post-tags" aria-label="태그">
  {entry.data.tags.map((tag) => <li><a href={tagPath(tag)}>{tag}</a></li>)}
</ul>}
