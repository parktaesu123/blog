---
import { categoryOf, type Post } from '../utils/posts';
import { sitePath } from '../utils/paths';
import { formatDate } from '../utils/dates';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
{posts.length === 0
  ? <p class="post-list-empty not-content">아직 발행된 글이 없습니다.</p>
  : <ul class="post-list not-content">
      {posts.map((post) => (
        <li>
          <a class="post-row" href={sitePath(`${post.id}/`)}>
            <span class="post-row-head">
              <span class="post-row-title">{post.data.title}</span>
              <span class="post-row-category">{categoryOf(post)}</span>
              {post.data.publishedAt && <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>}
            </span>
            {post.data.description && <span class="post-row-excerpt">{post.data.description}</span>}
          </a>
        </li>
      ))}
    </ul>}
