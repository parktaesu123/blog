---
// A quiet desk at night, lit by one lamp: the home hero's illustration.
const barcode = [3, 1, 2, 1, 4, 1, 1, 3, 2, 1, 1, 2, 3, 1, 2, 4, 1, 1, 2, 1, 3];
let x = 0;
const bars = barcode.map((width, index) => {
  const bar = { x, width, dark: index % 2 === 0 };
  x += width;
  return bar;
}).filter((bar) => bar.dark);
const scale = 72 / x;
---
<svg class="room-scene" viewBox="0 0 600 480" role="img" aria-label="스탠드 조명이 켜진 밤의 책상" preserveAspectRatio="xMidYMax meet">
  <defs>
    <radialGradient id="room-lamp-glow" cx="405" cy="196" r="190" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ffd58f" stop-opacity=".5" />
      <stop offset=".35" stop-color="#f0a94a" stop-opacity=".16" />
      <stop offset="1" stop-color="#f0a94a" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="room-lamp-beam" x1="0" y1="192" x2="0" y2="332" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ffe0a6" stop-opacity=".42" />
      <stop offset="1" stop-color="#ffd58f" stop-opacity=".04" />
    </linearGradient>
    <radialGradient id="room-candle-glow" cx="291" cy="298" r="58" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ffb347" stop-opacity=".55" />
      <stop offset="1" stop-color="#ffb347" stop-opacity="0" />
    </radialGradient>
    <pattern id="room-pinstripe" width="7" height="10" patternUnits="userSpaceOnUse">
      <rect width="7" height="10" fill="#141312" />
      <rect width="1.4" height="10" fill="#e9e3d8" />
    </pattern>
  </defs>

  <circle cx="405" cy="196" r="190" fill="url(#room-lamp-glow)" />

  <!-- Wall prints -->
  <g>
    <rect x="62" y="38" width="128" height="168" fill="#efe9de" stroke="#0b0a09" stroke-width="5" />
    <rect x="80" y="58" width="58" height="6" fill="#1a1918" />
    <rect x="80" y="70" width="38" height="6" fill="#1a1918" />
    <path d="M118 140c-11 0-19 8-19 18s8 18 18 18c3 0 5-1 7-2-1 9-7 16-16 19l2 5c16-4 27-17 27-33v-7c0-10-8-18-19-18Zm42 0c-11 0-19 8-19 18s8 18 18 18c3 0 5-1 7-2-1 9-7 16-16 19l2 5c16-4 27-17 27-33v-7c0-10-8-18-19-18Z" fill="#141312" />
  </g>
  <g>
    <rect x="216" y="84" width="104" height="74" fill="#efe9de" stroke="#0b0a09" stroke-width="4" />
    {bars.map((bar) => <rect x={232 + bar.x * scale} y="98" width={bar.width * scale} height="34" fill="#141312" />)}
    <rect x="232" y="138" width="44" height="4" fill="#141312" opacity=".6" />
  </g>

  <!-- Lamp light falling on the desk -->
  <polygon points="365,192 445,192 532,330 278,330" fill="url(#room-lamp-beam)" />
  <ellipse cx="405" cy="330" rx="128" ry="7" fill="#ffd58f" opacity=".28" />

  <!-- Desk lamp -->
  <g fill="#0c0b0a" stroke="#0c0b0a">
    <ellipse cx="478" cy="326" rx="32" ry="6.5" stroke="none" />
    <path d="M478 322V176l-62-24" fill="none" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="478" cy="176" r="5" stroke="none" />
    <polygon points="392,140 430,140 450,192 362,192" stroke="none" />
  </g>
  <ellipse cx="406" cy="192" rx="44" ry="5.5" fill="#ffe7b8" />
  <ellipse class="room-bulb" cx="406" cy="194" rx="16" ry="6" fill="#fff4d6" />

  <!-- Desk -->
  <rect x="18" y="328" width="564" height="9" rx="2" fill="#0b0a09" />
  <rect x="40" y="337" width="6" height="133" fill="#0b0a09" />
  <rect x="468" y="337" width="78" height="112" fill="#e9e3d8" stroke="#0b0a09" stroke-width="3" />
  <path d="M468 374h78M468 411h78" stroke="#0b0a09" stroke-width="3" />
  <g fill="#0b0a09">
    <rect x="499" y="352" width="16" height="4" rx="2" />
    <rect x="499" y="389" width="16" height="4" rx="2" />
    <rect x="499" y="426" width="16" height="4" rx="2" />
  </g>

  <!-- Things on the desk -->
  <rect x="86" y="314" width="96" height="14" fill="#efe9de" stroke="#0b0a09" stroke-width="2" />
  <rect x="94" y="301" width="82" height="13" fill="#141312" />
  <rect x="89" y="288" width="90" height="13" fill="url(#room-pinstripe)" stroke="#0b0a09" stroke-width="1.5" />
  <path d="M206 300h26v24a4 4 0 0 1-4 4h-18a4 4 0 0 1-4-4Z" fill="#efe9de" stroke="#0b0a09" stroke-width="2" />
  <path d="M232 305h5a6 6 0 0 1 0 12h-5" fill="none" stroke="#efe9de" stroke-width="3" />
  <circle cx="291" cy="300" r="58" fill="url(#room-candle-glow)" />
  <rect x="280" y="306" width="22" height="22" rx="3" fill="#f6efe2" opacity=".92" />
  <ellipse class="room-flame" cx="291" cy="298" rx="3.6" ry="7.5" fill="#ffcf73" />

  <!-- Floor and wavy rug -->
  <rect x="0" y="470" width="600" height="10" fill="#0d0c0b" />
  <rect x="96" y="444" width="250" height="60" rx="30" fill="#efe9de" />
  <path d="M118 466c14-12 28 12 42 0s28 12 42 0 28 12 42 0 28 12 42 0 28 12 42 0" fill="none" stroke="#141312" stroke-width="7" stroke-linecap="round" />
</svg>
