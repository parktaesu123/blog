---
import { sitePath } from '../utils/paths';
---
<dialog id="search-dialog" class="search-dialog" aria-label="글 검색" data-pagefind-ignore data-index={sitePath('pagefind/pagefind.js')}>
  <div class="search-box">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input id="search-query" type="search" placeholder="제목이나 본문으로 검색" autocomplete="off" aria-label="검색어" />
    <button id="close-search" type="button" class="search-close">닫기</button>
  </div>
  <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
  <div id="search-results" class="search-results"></div>
</dialog>
<script>
  import DOMPurify from 'dompurify';

  type Result = { data(): Promise<{ url: string; meta: { title?: string }; excerpt: string }> };
  type Index = { search(query: string): Promise<{ results: Result[] }> };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const query = document.getElementById('search-query') as HTMLInputElement;
  const status = document.getElementById('search-status')!;
  const results = document.getElementById('search-results')!;
  let index: Promise<Index> | undefined;
  let generation = 0;
  let timer: ReturnType<typeof setTimeout>;

  function open() {
    if (!dialog.open) dialog.showModal();
    query.select();
  }
  document.getElementById('open-search')?.addEventListener('click', open);
  document.getElementById('close-search')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); open(); }
  });

  query.addEventListener('input', () => {
    clearTimeout(timer);
    const turn = ++generation;
    timer = setTimeout(async () => {
      const text = query.value.trim();
      results.replaceChildren();
      if (!text) { status.textContent = ''; return; }
      status.textContent = '찾고 있습니다…';
      try {
        index ??= import(/* @vite-ignore */ dialog.dataset.index!);
        const found = await (await index).search(text);
        const entries = await Promise.all(found.results.slice(0, 10).map((result) => result.data()));
        if (turn !== generation) return;
        status.textContent = found.results.length ? `${found.results.length}개의 글` : '일치하는 글이 없습니다.';
        for (const entry of entries) {
          const link = document.createElement('a');
          link.className = 'search-result';
          link.href = entry.url;
          const heading = document.createElement('strong');
          heading.textContent = entry.meta.title || '제목 없음';
          const excerpt = document.createElement('p');
          excerpt.innerHTML = DOMPurify.sanitize(entry.excerpt, { ALLOWED_TAGS: ['mark'], ALLOWED_ATTR: [] });
          link.append(heading, excerpt);
          results.append(link);
        }
      } catch {
        if (turn === generation) status.textContent = '검색은 배포된 사이트(빌드 후)에서 사용할 수 있습니다.';
      }
    }, 160);
  });
</script>
