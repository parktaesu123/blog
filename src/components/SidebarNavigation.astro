---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

type Entry = StarlightRouteData['sidebar'][number];
interface Props { entries: Entry[]; nested?: boolean; label?: string; }
const { entries, nested = false, label } = Astro.props;
---
<ul class:list={['sidebar-navigation', nested ? 'category-posts' : 'sidebar-sections']} aria-label={label}>
  {entries.map((entry) => (
    <li>
      {entry.type === 'link' ? (
        <a {...entry.attrs} href={entry.href} aria-current={entry.isCurrent ? 'page' : undefined} class:list={['sidebar-link', entry.attrs.class, { 'sidebar-overview-link': !nested }]}>
          <span class="sidebar-link-label">{entry.label}</span>
        </a>
      ) : (
        <div class="sidebar-category">
          <div class="category-heading">{entry.label}</div>
          {entry.entries.length > 0 && <Astro.self entries={entry.entries} nested label={entry.label} />}
        </div>
      )}
    </li>
  ))}
</ul>
