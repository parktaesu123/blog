---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';

type Entry = StarlightRouteData['sidebar'][number];
interface Props { entries: Entry[]; nested?: boolean; }
const { entries, nested = false } = Astro.props;
const firstGroup = entries.findIndex((entry) => entry.type === 'group');
function countLinks(entry: Entry): number {
  return entry.type === 'link' ? 1 : entry.entries.reduce((count, child) => count + countLinks(child), 0);
}
function hasCurrent(entry: Entry): boolean {
  return entry.type === 'link' ? entry.isCurrent : entry.entries.some(hasCurrent);
}
const icons: Record<string, string> = {
  '홈': 'm3 10 9-7 9 7M5 9v11h5v-6h4v6h5V9',
  '모든 글': 'M4 5h16M4 12h16M4 19h16',
  '개발': 'm8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16',
  'TIL': 'M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Zm0 0v15',
  '일상·회고': 'M8 3h11a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H8a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm0 0v18m4-13h4m-4 4h4',
};
---
<ul class:list={['sidebar-navigation', nested ? 'category-posts' : 'sidebar-sections']}>
  {entries.map((entry, index) => <>
    {!nested && index === firstGroup && <li class="sidebar-section-label" aria-hidden="true">카테고리</li>}
    <li>
      {entry.type === 'link' ? (
        <a {...entry.attrs} href={entry.href} aria-current={entry.isCurrent ? 'page' : undefined} class:list={['sidebar-link', entry.attrs.class, { 'sidebar-overview-link': !nested }]}>
          {!nested && <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[entry.label] ?? icons['모든 글']} /></svg>}
          <span class="sidebar-link-label">{entry.label}</span>
        </a>
      ) : (
        <details class="sidebar-category" data-current={hasCurrent(entry) ? 'true' : undefined} open={countLinks(entry) > 0 && (hasCurrent(entry) || !entry.collapsed)}>
          <summary class="category-heading" aria-label={`${entry.label}, 글 ${countLinks(entry)}개`}>
            <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[entry.label] ?? icons['일상·회고']} /></svg>
            <span class="category-label">{entry.label}</span>
            <span class="category-count" aria-hidden="true">{countLinks(entry)}</span>
            <svg class="category-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 4 4 4-4 4" /></svg>
          </summary>
          <SidebarRestorePoint />
          {entry.entries.length > 0 ? <Astro.self entries={entry.entries} nested /> : <p class="category-empty">아직 글이 없습니다.</p>}
        </details>
      )}
    </li>
  </>)}
</ul>
