---
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Search from '../components/Search.astro';
import { blog } from '../../blog.config.mjs';
import { sitePath } from '../utils/paths';
import '../styles/custom.css';

interface Props {
  title?: string;
  description?: string;
  /** Marks the main content as searchable. */
  searchable?: boolean;
  noindex?: boolean;
  article?: boolean;
  wide?: boolean;
}
const { title, description = blog.description, searchable = false, noindex = false, article = false, wide = false } = Astro.props;
const pageTitle = title ? `${title} | ${blog.title}` : blog.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <link rel="sitemap" href={sitePath('sitemap-index.xml')} />
    <link rel="preload" href={sitePath('fonts/PretendardVariable.woff2')} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={blog.title} />
    <meta property="og:title" content={title ?? blog.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
  </head>
  <body class:list={[{ 'is-article': article }]}>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    {article && <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>}
    <Header />
    <div class="page-shell" data-pagefind-body={searchable || undefined}>
      <slot name="banner" />
      <main id="main" class:list={['site-main', { 'site-main-wide': wide }]}>
        <slot />
      </main>
    </div>
    <SiteFooter />
    <a class="to-top" href="#" aria-label="맨 위로" data-pagefind-ignore>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
    </a>
    <Search />
    <script>
      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      const article = document.querySelector<HTMLElement>('.article');
      if (progress && article) {
        const update = () => {
          const { top, height } = article.getBoundingClientRect();
          const ratio = Math.min(1, Math.max(0, -top / Math.max(1, height - window.innerHeight)));
          progress.style.transform = `scaleX(${ratio})`;
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      }
    </script>
  </body>
</html>
