---
import { render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import Comments from '../components/Comments.astro';
import OwnerControls from '../components/OwnerControls.astro';
import { blog } from '../../blog.config.mjs';
import { categoryIdOf, categoryOf, getPosts, sourceIdOf, type Post } from '../utils/posts';
import { categoryPath, sitePath, tagPath } from '../utils/paths';
import { formatDate } from '../utils/dates';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}
interface Props { post: Post; newer?: Post; older?: Post; }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const outline = post.data.tableOfContents === false ? [] : headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showComments = blog.comments.enabled && post.data.comments;
const publishedAt = post.data.publishedAt!;
---
<BlogLayout title={post.data.title} description={post.data.description || blog.description} searchable article wide={outline.length > 1}>
  <div class:list={['article-layout', { 'has-outline': outline.length > 1 }]}>
    <article class="article">
      <header class="article-header">
        <p class="article-meta">
          <a href={categoryPath(categoryIdOf(post))}>{categoryOf(post)}</a>
          <span aria-hidden="true">·</span>
          <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        </p>
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        {post.data.description && <p class="article-deck">{post.data.description}</p>}
        {post.data.tags.length > 0 && <ul class="post-tags" aria-label="태그">
          {post.data.tags.map((tag) => <li><a href={tagPath(tag)}>#{tag}</a></li>)}
        </ul>}
      </header>
      <div class="prose"><Content /></div>
      <div class="article-actions" data-pagefind-ignore>
        <a class="text-link" href={sitePath('posts/')}>← 글 목록</a>
        <OwnerControls article={sourceIdOf(post)} />
      </div>
      {(newer || older) && <nav class="article-pager" aria-label="이전·다음 글" data-pagefind-ignore>
        {older ? <a class="pager-link" href={sitePath(`${older.id}/`)}><span>이전 글</span><strong>{older.data.title}</strong></a> : <span></span>}
        {newer ? <a class="pager-link pager-next" href={sitePath(`${newer.id}/`)}><span>다음 글</span><strong>{newer.data.title}</strong></a> : <span></span>}
      </nav>}
      {showComments && <Comments />}
    </article>
    {outline.length > 1 && <aside class="article-outline" aria-label="목차" data-pagefind-ignore>
      <p>목차</p>
      <ol>
        {outline.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
      </ol>
    </aside>}
  </div>
</BlogLayout>
