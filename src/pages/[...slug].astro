---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import Comments from '../components/Comments.astro';
import OwnerControls from '../components/OwnerControls.astro';
import { blog } from '../../blog.config.mjs';
import { categoryOf, formatDate } from '../utils/posts';
import { sitePath, tagPath } from '../utils/paths';
export async function getStaticPaths() { const entries = await getCollection('docs'); return entries.filter((entry) => !entry.data.draft && entry.id !== 'index').map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'docs'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const article = Boolean(entry.data.publishedAt);
---
<BlogLayout title={entry.data.title} description={entry.data.description} variant={article ? 'article' : 'page'} searchBody>
  <div class="reading-layout"><article class="reading-body">
    <header class="article-heading"><p class="eyebrow">{article ? categoryOf(entry) : 'ABOUT'}</p><h1 data-pagefind-meta="title">{entry.data.title}</h1>{entry.data.description && <p class="article-deck">{entry.data.description}</p>}
      {entry.data.publishedAt && <div class="article-meta"><time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time>{entry.data.updatedAt && <span>수정 {formatDate(entry.data.updatedAt)}</span>}<OwnerControls article={entry.id} /></div>}
      {entry.data.tags.length > 0 && <ul class="post-tags" aria-label="태그">{entry.data.tags.map((tag) => <li><a href={tagPath(tag)}>#{tag}</a></li>)}</ul>}
    </header>
    <div class="prose"><Content /></div>
    {article && <div class="article-bottom"><a class="text-link" href={sitePath('posts/')}>← 글 목록으로</a><OwnerControls article={entry.id} /></div>}
    {article && blog.comments.enabled && entry.data.comments && <Comments />}
  </article>{article && headings.length > 1 && <aside class="reading-outline" aria-label="이 글의 목차" data-pagefind-ignore><p>이 글에서</p>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</aside>}</div>
</BlogLayout>
