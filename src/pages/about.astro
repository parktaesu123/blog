---
import { render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import Profile from '../components/Profile.astro';
import OwnerControls from '../components/OwnerControls.astro';
import { getIntroduction, sourceIdOf } from '../utils/posts';

const intro = await getIntroduction();
if (!intro) throw new Error('소개글(slug: about)을 찾을 수 없습니다.');
const { Content } = await render(intro);
---
<BlogLayout title="소개" description={intro.data.description} searchable>
  <PageBanner slot="banner">
    <p class="banner-eyebrow">About</p>
    <h1 data-pagefind-meta="title">{intro.data.title}</h1>
    <Profile size="large" />
  </PageBanner>
  <article class="about-body">
    <div class="prose"><Content /></div>
  </article>
  <div class="article-actions">
    <OwnerControls article={sourceIdOf(intro)} label="소개글 수정" />
  </div>
</BlogLayout>
