---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import PostList from '../../components/PostList.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import { getPosts, groupByCategory, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return groupByCategory(posts).map((group) => ({
    params: { category: group.id },
    props: { id: group.id, label: group.label, posts, categoryPosts: group.posts },
  }));
}
interface Props { id: string; label: string; posts: Post[]; categoryPosts: Post[]; }
const { id, label, posts, categoryPosts } = Astro.props;
---
<BlogLayout title={label} description={`${label} 카테고리의 글 모음`}>
  <PageBanner slot="banner">
    <p class="banner-eyebrow">Category</p>
    <h1>{label}</h1>
    <p class="banner-lede">{categoryPosts.length}개의 글</p>
  </PageBanner>
  <CategoryTabs posts={posts} active={id} />
  <PostList posts={categoryPosts} />
</BlogLayout>
