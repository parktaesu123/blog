---
import BlogLayout from '../layouts/BlogLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import PostCard from '../components/PostCard.astro';
import PostCover from '../components/PostCover.astro';
import { blog } from '../../blog.config.mjs';
import { categoryOf, coverOf, getPosts, groupByCategory } from '../utils/posts';
import { categoryPath, sitePath } from '../utils/paths';
import { formatDate } from '../utils/dates';

const posts = await getPosts();
const groups = groupByCategory(posts);
const featured = posts[0];
---
<BlogLayout description={blog.description} wide>
  <PageBanner slot="banner" variant="home">
    <h1>{blog.title}</h1>
    <p class="hero-lede">{blog.description}</p>
    {featured && (
      <a class="hero-feature" slot="aside" href={sitePath(`${featured.id}/`)}>
        {coverOf(featured) && <PostCover post={featured} />}
        <span class="hero-feature-body">
          <span class="hero-feature-label">최근 글 · {categoryOf(featured)}</span>
          <strong>{featured.data.title}</strong>
          {featured.data.description && <span class="hero-feature-excerpt">{featured.data.description}</span>}
          <time class="hero-feature-meta" datetime={featured.data.publishedAt!.toISOString()}>{formatDate(featured.data.publishedAt!)}</time>
        </span>
      </a>
    )}
  </PageBanner>

  <section class="home-section" aria-labelledby="home-categories">
    <div class="section-heading">
      <h2 id="home-categories">카테고리</h2>
    </div>
    <ul class="category-grid">
      {groups.map((group) => (
        <li>
          <a class="category-card" href={categoryPath(group.id)}>
            <span class="category-card-head">
              <span class="category-card-name">{group.label}</span>
              <span class="category-card-count">{group.posts.length}</span>
            </span>
            {group.posts[0] && <span class="category-card-latest">{group.posts[0].data.title}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section" aria-labelledby="home-recent">
    <div class="section-heading">
      <h2 id="home-recent">최신 글</h2>
      <a class="text-link" href={sitePath('posts/')}>전체 보기</a>
    </div>
    {posts.length
      ? <div class="card-grid">{posts.slice(0, 6).map((post) => <PostCard post={post} />)}</div>
      : <p class="post-list-empty">아직 발행된 글이 없습니다.</p>}
  </section>
</BlogLayout>
