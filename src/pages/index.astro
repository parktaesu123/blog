---
import BlogLayout from '../layouts/BlogLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import PostCard from '../components/PostCard.astro';
import { blog } from '../../blog.config.mjs';
import { getPosts, groupByCategory, tagsOf } from '../utils/posts';
import { categoryPath, sitePath } from '../utils/paths';

const posts = await getPosts();
const groups = groupByCategory(posts);
const avatar = `https://github.com/${blog.admin.owner}.png?size=200`;
const firstPost = posts.at(-1)?.data.publishedAt;
const daysSince = firstPost ? Math.floor((Date.now() - firstPost.getTime()) / 86_400_000) + 1 : 1;
const heroImage = blog.hero.image ? sitePath(blog.hero.image) : undefined;
const [firstWord] = blog.hero.rotating;
const stats = [
  { label: '발행한 글', value: posts.length, unit: '개', icon: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6' },
  { label: '카테고리', value: groups.length, unit: '개', icon: 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z' },
  { label: '태그', value: tagsOf(posts).length, unit: '개', icon: 'M9 4 7 20M17 4l-2 16M4 9h16M3 15h16' },
  { label: '기록한 지', value: daysSince, unit: '일째', icon: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4', days: firstPost?.toISOString() },
];
---
<BlogLayout description={blog.description} wide>
  <PageBanner slot="banner" variant="home" image={heroImage}>
    <h1 class="sr-only">{blog.title}</h1>
    <p class="hero-badge">{blog.hero.badge}</p>
    <p class="hero-headline">
      <span>{blog.hero.headline}</span>
      <span class="hero-typed-line">
        <span class="sr-only">{blog.hero.rotating.join(' ')}</span>
        <span class="hero-typed" aria-hidden="true" data-words={JSON.stringify(blog.hero.rotating)}>{firstWord}</span><span class="hero-caret" aria-hidden="true"></span>
      </span>
    </p>
    <div class="hero-quote" aria-hidden="true">
      <span></span>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M9.5 6C6.5 6 4 8.3 4 11.3c0 2.6 2 4.6 4.5 4.6.4 0 .8 0 1.2-.2-.5 1.6-1.9 2.9-3.7 3.4l.6 1.4c3.6-.9 6-3.9 6-7.6v-1.4C12.6 8.4 11.3 6 9.5 6Zm9 0c-3 0-5.5 2.3-5.5 5.3 0 2.6 2 4.6 4.5 4.6.4 0 .8 0 1.2-.2-.5 1.6-1.9 2.9-3.7 3.4l.6 1.4c3.6-.9 6-3.9 6-7.6v-1.4C21.6 8.4 20.3 6 18.5 6Z"/></svg>
      <span></span>
    </div>
    <p class="hero-lede">{blog.description}</p>
    <div class="hero-actions">
      <a class="button button-glow" href={sitePath('posts/')}>글 둘러보기</a>
      <a class="button button-ghost" href={sitePath('about/')}>소개 보기</a>
    </div>
    <a class="hero-scroll" href="#home-welcome" aria-label="아래로 내려가기">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </a>
  </PageBanner>

  <section class="home-welcome" id="home-welcome" aria-labelledby="welcome-title">
    <ul class="stat-grid">
      {stats.map((stat) => (
        <li class="stat-card">
          <span class="stat-icon"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={stat.icon} /></svg></span>
          <strong><span data-days-since={stat.days}>{stat.value.toLocaleString('ko-KR')}</span>{stat.unit}</strong>
          <span>{stat.label}</span>
        </li>
      ))}
    </ul>
    <div class="welcome-text">
      <p class="section-eyebrow">Welcome</p>
      <h2 id="welcome-title">찾아와 주셔서<br /><mark>반가워요</mark></h2>
      <p>{blog.description} 천천히 둘러보시고, 마음에 남는 글이 있다면 GitHub 계정으로 댓글이나 이모지를 남겨 주세요.</p>
      <div class="welcome-profile">
        <img src={avatar} alt="" width="48" height="48" loading="lazy" decoding="async" />
        <span><strong>{blog.profile.name}</strong><small>{blog.profile.role}</small></span>
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="home-categories">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">Category</p>
        <h2 id="home-categories">카테고리</h2>
        <p class="section-lede">관심 가는 주제부터 골라 보세요.</p>
      </div>
    </div>
    <ul class="category-grid">
      {groups.map((group) => (
        <li>
          <a class="category-card" href={categoryPath(group.id)}>
            <span class="category-icon" aria-hidden="true">{group.label.slice(0, 1)}</span>
            <span class="category-card-name">{group.label}</span>
            <span class="category-card-count">{group.posts.length}개의 글</span>
            <span class="category-card-latest">{group.posts[0]?.data.title ?? '아직 글이 없습니다.'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section" aria-labelledby="home-recent">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">Latest</p>
        <h2 id="home-recent">최신 글</h2>
        <p class="section-lede">가장 최근에 불을 켜 둔 글들이에요.</p>
      </div>
      <a class="text-link" href={sitePath('posts/')}>모든 글 보기 →</a>
    </div>
    {posts.length
      ? <div class="card-grid">{posts.slice(0, 6).map((post) => <PostCard post={post} />)}</div>
      : <p class="post-list-empty">아직 발행된 글이 없습니다.</p>}
  </section>
</BlogLayout>
<script>
  const typed = document.querySelector<HTMLElement>('.hero-typed');
  const words: string[] = typed ? JSON.parse(typed.dataset.words ?? '[]') : [];
  if (typed && words.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let word = 0;
    let length = words[0].length;
    let deleting = true;
    const tick = () => {
      const text = words[word];
      length += deleting ? -1 : 1;
      typed.textContent = text.slice(0, length);
      let delay = deleting ? 45 : 110;
      if (!deleting && length === text.length) { deleting = true; delay = 2200; }
      else if (deleting && length === 0) { deleting = false; word = (word + 1) % words.length; delay = 350; }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 2600);
  }

  for (const element of document.querySelectorAll<HTMLElement>('[data-days-since]')) {
    const start = Date.parse(element.dataset.daysSince ?? '');
    if (!Number.isNaN(start)) element.textContent = (Math.floor((Date.now() - start) / 86_400_000) + 1).toLocaleString('ko-KR');
  }
</script>
