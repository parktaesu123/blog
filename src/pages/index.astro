---
import BlogLayout from '../layouts/BlogLayout.astro';
import PostList from '../components/PostList.astro';
import Profile from '../components/Profile.astro';
import { getPosts, categoryOf } from '../utils/posts';
import { design } from '../utils/design';
import { sitePath } from '../utils/paths';
const posts = await getPosts();
const topics = [...new Set(posts.map(categoryOf))];
---
<BlogLayout title="홈" variant="home">
  <div class="personal-home">
    <Profile />
    <div class="home-journal">
      <div class="journal-intro">
        <p class="eyebrow">PERSONAL JOURNAL</p>
        <h2>{design.headline}</h2>
      </div>
      <section>
        <div class="section-heading">
          <h2>최근 기록<span class="quiet-count">{String(posts.length).padStart(2, '0')}</span></h2>
          <a class="text-link" href={sitePath('posts/')}>모든 글 보기 ↗</a>
        </div>
        <PostList posts={posts.slice(0, 6)} />
      </section>
      <div class="home-footnote">천천히 읽어도 좋은 기록들. {topics.join(' · ')}</div>
    </div>
  </div>
</BlogLayout>
