---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagsOf, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagsOf(posts).map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}
interface Props { tag: string; posts: Post[]; }
const { tag, posts } = Astro.props;
---
<BlogLayout title={`#${tag}`} description={`${tag}에 관한 글 모음`}>
  <PageBanner slot="banner">
    <p class="banner-eyebrow">태그</p>
    <h1>#{tag}</h1>
    <p class="banner-lede">{posts.length}개의 글</p>
  </PageBanner>
  <PostList posts={posts} />
</BlogLayout>
